# Replace each placeholder key with a real key before running the corresponding mode.
# Local / Direct mode (default)
LLM_PROVIDER=gemini           # gemini or openai
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen

# ASR (Speech-to-Text)
ASR_PROVIDER=elevenlabs       # elevenlabs or whisper
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_SCRIBE_MODEL=scribe_v1

# Optional fallback providers
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Local whisper.cpp (ASR_PROVIDER=whisper; requires whisper-cli on PATH)
LOCAL_WHISPER_MODEL=base       # tiny, base, small, medium, large-v3
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# API mode (MuAPI - optional)
MUAPI_API_KEY=your_muapi_key_here
